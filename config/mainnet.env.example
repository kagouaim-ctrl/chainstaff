# Copy to config/mainnet.env and fill in. Only non-secret settings go here:
# the Telegram token and the Turnkey API private key are asked for at start.
CHAINSTAFF_DB=data/mainnet.db
CHAINSTAFF_CHAIN=config/chain.json
CHAINSTAFF_LIVE=1
CHAINSTAFF_WALLET=turnkey
CHAINSTAFF_ALLOW_MAINNET=yes
TURNKEY_ORG_ID=
TURNKEY_SIGN_WITH=
TURNKEY_API_PUBLIC_KEY=
