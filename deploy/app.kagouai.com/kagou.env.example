# KAGOU server environment for app.kagouai.com. Copy to kagou.env on the server; never commit kagou.env.
# Defaults are read-only: BSC testnet, no wallet, no live payments.

# Console login token (required). Generate: python3 -c "import secrets;print(secrets.token_urlsafe(32))"
CHAINSTAFF_CONSOLE_TOKEN=

# Read-only demo login for a public demo instance (optional, 16+ characters, different from the console token).
KAGOU_DEMO_TOKEN=

# Only when the console is hosted on another site than this server (built with VITE_API_BASE): its exact origin(s),
# comma-separated, e.g. https://console.kagouai.com. Leave empty when the console is served from this server (/terminal/).
KAGOU_CORS_ORIGINS=

# Shown in Settings → System; set to the deployed commit.
KAGOU_VERSION=

# Chain: chain.json is mounted read-only at this path (testnet example: chain id 97, rpc_urls, ws_urls, confirmations).
CHAINSTAFF_CHAIN=/app/config/chain.json

# BSC realtime listener and background duties (1 = on, 0 = off).
KAGOU_CHAIN_LISTENER=1
KAGOU_BACKGROUND=1

# Model calls run on this server only; keys never reach the browser. Leave all empty to keep agents off.
# Shared model for every agent with provider "openai_compat": qwen | gemini | groq | openrouter | openai_compatible | local.
# Qwen (Alibaba Cloud Model Studio, Singapore): AI_BASE_URL is the OpenAI-compatible URL from the console, e.g.
# https://<WorkspaceId>.ap-southeast-1.maas.aliyuncs.com/compatible-mode/v1 ; AI_MODEL e.g. qwen-plus (supports tool calls).
AI_PROVIDER=
AI_BASE_URL=
AI_API_KEY=
AI_MODEL=
# Optional: "input,output" USD per million tokens (needed outside Qwen Singapore to get costs; local = 0 by default).
AI_PRICE=
# Cost controls (empty or 0 = no cap): spend per UTC day / calendar month, model calls per agent run, calls in flight.
AI_DAILY_BUDGET_USD=1
AI_MONTHLY_BUDGET_USD=10
AI_MAX_AGENT_STEPS=8
AI_MAX_CONCURRENT_TASKS=5
AI_MAX_OUTPUT_TOKENS=2048
AI_REQUEST_TIMEOUT=60
# Optional second provider for agents with provider "anthropic" (default model: Claude Haiku 5.5, the cheapest).
ANTHROPIC_API_KEY=

# Optional: explorer API for the chain monitor's transfer history and the treasury alerts.
ETHERSCAN_API_KEY=

# Deliberately absent in this phase: CHAINSTAFF_LIVE, CHAINSTAFF_WALLET*, CHAINSTAFF_ANCHOR_WALLET, TURNKEY_*.
# Agents only read the chain. Any on-chain write needs its own permission and human-approval design first.
